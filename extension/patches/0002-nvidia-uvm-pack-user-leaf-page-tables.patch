From: Christopher Owen
Subject: nvidia-uvm: pack 256-byte user leaf page tables on 64 KiB kernels

phys_mem_allocate_sysmem() backs every page table with alloc_pages(order of
size). On GB10 the depth-5 tables for 64 KiB GPU pages are 256 bytes (32
entries covering 2 MiB), so a 64 KiB kernel spends a whole 64 KiB CPU page on
each: 64 KiB per 2 MiB of GPU-mapped memory, against 4 KiB on a 4 KiB kernel.
A loaded model measured 3.25 GiB of table backing instead of 0.20 GiB.

Give each such table a 4 KiB slot in a per-page-tree pool of 64 KiB pages,
sixteen per page. A pool page comes from the original allocator, keeping its
memcg charge, DMA mapping and mapped-page accounting, and is unmapped and freed
when its last slot is. The tree tracker wait in phys_mem_deallocate_sysmem()
precedes slot reuse; reused slots are zeroed. A spinlock covers only the slot
bitmap and available list, because allocate_directory() runs without the tree
lock.

Packing applies only to 256-byte requests in user trees on a 64 KiB kernel,
for an integrated GPU without vidmem whose DMA is coherent. Roots and every
other table keep the original allocator. uvm_pack_sysmem_leaf_tables (default
on, read-only) set to 0 restores the stock allocator.

From https://github.com/christopherowen/dgx-spark-memory-saver
(patches/0001-pack-user-leaf-tables.patch with packaging/enable-packing.patch).

--- a/kernel-open/nvidia-uvm/uvm_mmu.h
+++ b/kernel-open/nvidia-uvm/uvm_mmu.h
@@ -133,6 +133,9 @@
     uvm_gpu_phys_address_t addr;
 
     NvU64 size;
+
+    // Non-NULL only for packed sysmem leaf tables.
+    struct uvm_mmu_sysmem_pool_page *sysmem_pool_page;
 
     union
     {
@@ -275,6 +278,9 @@
 struct uvm_page_tree_struct
 {
     uvm_mutex_t lock;
+    // Leaf lock: never held across allocation, DMA mapping or tracker waits.
+    spinlock_t sysmem_pool_lock;
+    struct list_head sysmem_pool_available;
     uvm_gpu_t *gpu;
     uvm_page_directory_t *root;
     uvm_mmu_mode_hal_t *hal;
--- a/kernel-open/nvidia-uvm/uvm_mmu.c
+++ b/kernel-open/nvidia-uvm/uvm_mmu.c
@@ -38,6 +38,7 @@
 
 #include <asm/io.h>
 #include <linux/mm.h>
+#include <linux/dma-map-ops.h>
 
 // The page tree has 6 levels on Hopper+ GPUs, and the root is never freed by a
 // normal 'put' operation which leaves a maximum of 5 levels.
@@ -74,6 +75,25 @@
 MODULE_PARM_DESC(uvm_page_table_location,
                 "Set the location for UVM-allocated page tables. Choices are: vid, sys.");
 
+// Retain the original DMA mapping per CPU page, but give each small user leaf
+// table a separate 4 KiB slot. Roots and other table sizes retain their
+// original allocation. On by default; =0 restores the stock allocator. Inert
+// on 4 KiB kernels.
+static bool uvm_pack_sysmem_leaf_tables = true;
+module_param(uvm_pack_sysmem_leaf_tables, bool, S_IRUGO);
+MODULE_PARM_DESC(uvm_pack_sysmem_leaf_tables,
+                "Pack 256-byte user leaf tables on coherent integrated 64 KiB systems");
+
+#define UVM_SYSMEM_TABLE_SLOT_SIZE 4096
+#define UVM_SYSMEM_TABLE_SLOT_COUNT (PAGE_SIZE / UVM_SYSMEM_TABLE_SLOT_SIZE)
+
+struct uvm_mmu_sysmem_pool_page
+{
+    struct list_head available;
+    unsigned long used;
+    uvm_mmu_page_table_alloc_t backing;
+};
+
 NV_STATUS uvm_mmu_init(void)
 {
     UVM_ASSERT((page_table_aperture == UVM_APERTURE_VID) ||
@@ -100,7 +120,7 @@
     return NV_OK;
 }
 
-static NV_STATUS phys_mem_allocate_sysmem(uvm_page_tree_t *tree, NvLength size, uvm_mmu_page_table_alloc_t *out)
+static NV_STATUS phys_mem_allocate_sysmem_full_page(uvm_page_tree_t *tree, NvLength size, uvm_mmu_page_table_alloc_t *out)
 {
     NV_STATUS status = NV_OK;
     NvU64 dma_addr;
@@ -147,7 +167,67 @@
 
     out->addr = uvm_gpu_phys_address(UVM_APERTURE_SYS, dma_addr);
     out->size = size;
+
+    return NV_OK;
+}
+
+static NV_STATUS phys_mem_allocate_sysmem(uvm_page_tree_t *tree,
+                                         NvLength size,
+                                         uvm_mmu_page_table_alloc_t *out)
+{
+    struct uvm_mmu_sysmem_pool_page *pool;
+    unsigned long slot;
+    NV_STATUS status;
+    void *cpu;
+
+    // Keep packing away from non-coherent DMA, fake GPUs, roots,
+    // kernel trees and platforms with different base-page geometry.
+    if (!uvm_pack_sysmem_leaf_tables || PAGE_SIZE != 65536 || size != 256 ||
+        tree->type != UVM_PAGE_TREE_TYPE_USER || !tree->gpu->parent->pci_dev ||
+        !tree->gpu->parent->is_integrated_gpu || tree->gpu->mem_info.size ||
+        !dev_is_dma_coherent(&tree->gpu->parent->pci_dev->dev))
+        return phys_mem_allocate_sysmem_full_page(tree, size, out);
+
+    spin_lock(&tree->sysmem_pool_lock);
+    if (!list_empty(&tree->sysmem_pool_available)) {
+        pool = list_first_entry(&tree->sysmem_pool_available,
+                                struct uvm_mmu_sysmem_pool_page, available);
+        slot = find_first_zero_bit(&pool->used, UVM_SYSMEM_TABLE_SLOT_COUNT);
+        UVM_ASSERT(slot < UVM_SYSMEM_TABLE_SLOT_COUNT);
+        __set_bit(slot, &pool->used);
+        if (bitmap_full(&pool->used, UVM_SYSMEM_TABLE_SLOT_COUNT))
+            list_del_init(&pool->available);
+        spin_unlock(&tree->sysmem_pool_lock);
+    }
+    else {
+        spin_unlock(&tree->sysmem_pool_lock);
+        pool = kzalloc(sizeof(*pool), NV_UVM_GFP_FLAGS);
+        if (!pool)
+            return NV_ERR_NO_MEMORY;
 
+        // This retains the existing memcg charge, DMA address translation,
+        // physical TLB invalidation and mapped_cpu_pages_size accounting.
+        status = phys_mem_allocate_sysmem_full_page(tree, PAGE_SIZE, &pool->backing);
+        if (status != NV_OK) {
+            kfree(pool);
+            return status;
+        }
+        INIT_LIST_HEAD(&pool->available);
+        slot = 0;
+        __set_bit(slot, &pool->used);
+        spin_lock(&tree->sysmem_pool_lock);
+        list_add(&pool->available, &tree->sysmem_pool_available);
+        spin_unlock(&tree->sysmem_pool_lock);
+    }
+
+    *out = pool->backing;
+    out->size = size;
+    out->sysmem_pool_page = pool;
+    out->addr.address += slot * UVM_SYSMEM_TABLE_SLOT_SIZE;
+    // No slot shares CPU cache lines. Coherent DMA is required above.
+    cpu = kmap(out->handle.page);
+    memset((char *)cpu + slot * UVM_SYSMEM_TABLE_SLOT_SIZE, 0, UVM_SYSMEM_TABLE_SLOT_SIZE);
+    kunmap(out->handle.page);
     return NV_OK;
 }
 
@@ -237,6 +317,29 @@
         UVM_ASSERT(status == uvm_global_get_status());
 
     UVM_ASSERT(ptr->addr.aperture == UVM_APERTURE_SYS);
+    if (ptr->sysmem_pool_page) {
+        struct uvm_mmu_sysmem_pool_page *pool = ptr->sysmem_pool_page;
+        unsigned long slot = (ptr->addr.address - pool->backing.addr.address) / UVM_SYSMEM_TABLE_SLOT_SIZE;
+        bool empty;
+
+        // The existing tracker wait above precedes reuse of any slot.
+        spin_lock(&tree->sysmem_pool_lock);
+        UVM_ASSERT(slot < UVM_SYSMEM_TABLE_SLOT_COUNT && test_bit(slot, &pool->used));
+        if (bitmap_full(&pool->used, UVM_SYSMEM_TABLE_SLOT_COUNT))
+            list_add(&pool->available, &tree->sysmem_pool_available);
+        __clear_bit(slot, &pool->used);
+        empty = bitmap_empty(&pool->used, UVM_SYSMEM_TABLE_SLOT_COUNT);
+        if (empty)
+            list_del_init(&pool->available);
+        spin_unlock(&tree->sysmem_pool_lock);
+
+        if (empty) {
+            uvm_parent_gpu_unmap_cpu_pages(tree->gpu->parent, pool->backing.addr.address, PAGE_SIZE);
+            __free_pages(pool->backing.handle.page, 0);
+            kfree(pool);
+        }
+        return;
+    }
     if (tree->gpu->parent->pci_dev)
         uvm_parent_gpu_unmap_cpu_pages(tree->gpu->parent, ptr->addr.address, UVM_PAGE_ALIGN_UP(ptr->size));
     __free_pages(ptr->handle.page, get_order(ptr->size));
@@ -1128,6 +1231,8 @@
 
     memset(tree, 0, sizeof(*tree));
     uvm_mutex_init(&tree->lock, UVM_LOCK_ORDER_PAGE_TREE);
+    spin_lock_init(&tree->sysmem_pool_lock);
+    INIT_LIST_HEAD(&tree->sysmem_pool_available);
     tree->hal = gpu->parent->arch_hal->mmu_mode_hal(big_page_size);
     UVM_ASSERT(tree->hal != NULL);
     UVM_ASSERT(MAX_OPERATION_DEPTH >= tree->hal->page_table_depth(UVM_PAGE_SIZE_AGNOSTIC));
@@ -1224,6 +1329,7 @@
 
     uvm_mutex_unlock(&tree->lock);
 
+    UVM_ASSERT(list_empty(&tree->sysmem_pool_available));
     uvm_tracker_deinit(&tree->tracker);
     uvm_kvfree(tree->root);
 }
